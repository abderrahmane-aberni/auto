# Copy this file to .env and fill in real values. .env is git-ignored.

# Used for both the agent's extraction/tool-calling step and (if you add it
# later) any embedding work. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A dedicated Neon Postgres database for this project (see README "Why a
# separate database" - it's not a literal reuse of Ledger's production DB).
# Use the pooled connection string (the one with "-pooler" in the hostname).
DATABASE_URL=

# Hard ceiling on tool calls per job posting before the agent is force-
# stopped - the main safety property of the hand-rolled loop.
MAX_AGENT_STEPS=8
FETCH_TIMEOUT_SECONDS=15

# Downloaded by scripts/update_sponsor_register.py (needs real network
# access to gov.uk - see that script's docstring for why it isn't fetched
# automatically).
SPONSOR_REGISTER_CSV=data/sponsor_register.csv
SPONSOR_MATCH_THRESHOLD=85
